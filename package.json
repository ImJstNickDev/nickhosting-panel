{
  "name": "nickhosting-panel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx --env-file=.env packages/database/src/migrate-cli.ts",
    "dev:api": "tsx --env-file=.env apps/api/src/main.ts",
    "dev:worker": "tsx --env-file=.env apps/worker/src/main.ts",
    "test:isolated": "tsx scripts/test-env.ts pnpm test:integration",
    "test:m2": "tsx scripts/test-env.ts --m2 pnpm test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
