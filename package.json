{
  "name": "nickhosting-panel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit && pnpm --filter @nickhosting/web typecheck",
    "i18n:compile": "tsx scripts/compile-web-i18n.ts",
    "i18n:check": "tsx scripts/compile-web-i18n.ts --check",
    "dev:web": "pnpm i18n:compile && pnpm --filter @nickhosting/web dev",
    "build": "pnpm i18n:compile && pnpm --filter @nickhosting/web build",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.browser.test.ts'",
    "test:browser": "pnpm i18n:compile && tsx scripts/test-env.ts --m2 pnpm exec vitest run --config vitest.browser.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx --env-file=.env packages/database/src/migrate-cli.ts",
    "dev:api": "tsx --env-file=.env apps/api/src/main.ts",
    "dev:worker": "tsx --env-file=.env apps/worker/src/main.ts",
    "test:isolated": "tsx scripts/test-env.ts pnpm test:integration",
    "test:m2": "tsx scripts/test-env.ts --m2 pnpm test:integration",
    "dev:gateway": "tsx --env-file=.env.gateway.local apps/game-gateway/src/main.ts",
    "test:m3": "tsx scripts/test-env.ts --m2 pnpm test:integration"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@lingui/message-utils": "6.9.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/yazl": "3.3.1",
    "minecraft-protocol": "1.68.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yazl": "3.3.1"
  }
}
