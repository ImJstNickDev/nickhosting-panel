worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  client_max_body_size 0;
  client_body_timeout 3600s;
  send_timeout 3600s;
  resolver 127.0.0.11 valid=5s ipv6=off;
  map $http_upgrade $connection_upgrade { default upgrade; '' ''; }
  upstream core { zone core 64k; server api:3001 resolve; }

  # Exact public hostnames are configured by NPM. The dedicated listener cannot serve panel routes.
  upstream dashboard { zone dashboard 64k; server api:3002 resolve; }
  server {
    listen 8081 default_server;
    server_name _;
    client_max_body_size 1m;
    client_body_timeout 15s;
    location / {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Host "";
      proxy_set_header Forwarded "";
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Connection "";
      proxy_set_header Upgrade "";
      proxy_http_version 1.1;
      proxy_pass http://dashboard;
    }
  }
  server {
    listen 8080 default_server;
    server_name _;
    location = /healthz { access_log off; return 200 'ok\n'; }
    location / { return 444; }
  }
  server {
    listen 8080;
    server_name ${NH_PUBLIC_HOST};
    location = /healthz { access_log off; return 200 'ok\n'; }
    location = /v1 { include /opt/nickhosting/proxy.conf; proxy_pass http://core; }
    location /v1/ { include /opt/nickhosting/proxy.conf; proxy_pass http://core; }
    location = /api/auth { include /opt/nickhosting/proxy.conf; proxy_pass http://core; }
    location /api/auth/ { include /opt/nickhosting/proxy.conf; proxy_pass http://core; }
    location /api/ { return 404; }
    root /usr/share/nginx/html;
    location /assets/ {
      gzip on;
      gzip_min_length 1024;
      gzip_comp_level 4;
      gzip_proxied any;
      gzip_vary on;
      gzip_types application/javascript text/javascript application/json text/css image/svg+xml;
      try_files $uri =404;
      add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /index.html { add_header Cache-Control "no-store"; }
    location / { try_files $uri $uri/ /index.html; }
  }
}
