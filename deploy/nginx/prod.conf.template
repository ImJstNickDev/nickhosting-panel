worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  client_max_body_size 0;
  client_body_timeout 3600s;
  send_timeout 3600s;
  resolver 127.0.0.11 valid=5s ipv6=off;
  map $http_upgrade $connection_upgrade { default upgrade; '' ''; }
  upstream core { zone core 64k; server api:3001 resolve; }

  server {
    listen 8080 default_server;
    server_name _;
    location = /healthz { access_log off; return 200 'ok\n'; }
    location / { return 444; }
  }
  server {
    listen 8080;
    server_name ${NH_PUBLIC_HOST};
    location = /healthz { access_log off; return 200 'ok\n'; }
    location = /v1 { include /opt/nickhosting/proxy.conf; proxy_pass http://core; }
    location /v1/ { include /opt/nickhosting/proxy.conf; proxy_pass http://core; }
    location = /api/auth { include /opt/nickhosting/proxy.conf; proxy_pass http://core; }
    location /api/auth/ { include /opt/nickhosting/proxy.conf; proxy_pass http://core; }
    location /api/ { return 404; }
    root /usr/share/nginx/html;
    location /assets/ { try_files $uri =404; add_header Cache-Control "public, max-age=31536000, immutable"; }
    location = /index.html { add_header Cache-Control "no-store"; }
    location / { try_files $uri $uri/ /index.html; }
  }
}
