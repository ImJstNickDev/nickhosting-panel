# Parsing sample only. Startup rejects placeholders. Generate independent local values
# using the approved preparation procedure; never copy production/test credentials.
NH_DEV_ENV_FILE=deploy/dev/.env.example
# Sandbox by default. Real mode uses the additional Compose overlay; never put
# Pterodactyl keys here. COMPOSE_FILE is read by `docker compose --env-file ...`.
COMPOSE_FILE=compose.dev.yaml
# For real mode: COMPOSE_FILE=compose.dev.yaml:compose.dev.real.yaml
# Replace this documentation-only address with the Owner's actual resolver.
NH_DEV_PROVIDER_DNS=192.0.2.53
# Optional real-mode evidence verifier: original trusted runner key, 64 lowercase
# hex characters. Never generate/re-sign evidence merely to expose a game choice.
# NH_DEV_MINECRAFT_EVIDENCE_KEY=
NH_DEV_PUBLIC_URL=https://dev.hub.nickhost.ing
NH_DEV_UID=1000
NH_DEV_GID=1000
NH_DEV_DB_PASSWORD=GENERATE_UNIQUE_DEV_DATABASE_PASSWORD
NH_DEV_REDIS_PASSWORD=GENERATE_UNIQUE_DEV_REDIS_PASSWORD
NH_DEV_MASTER_KEY=GENERATE_32_RANDOM_BYTES_AS_CANONICAL_BASE64
NH_DEV_AUTH_SECRET=GENERATE_UNIQUE_DEV_AUTH_SECRET_32_BYTES
NH_DEV_SETUP_TOKEN=GENERATE_UNIQUE_DEV_SETUP_TOKEN_32_BYTES
NH_DEV_SANDBOX_TOKEN=GENERATE_UNIQUE_DEV_SANDBOX_TOKEN_32_BYTES
NH_DEV_MAIL_PASSWORD=GENERATE_UNIQUE_DEV_MAIL_PASSWORD_32_BYTES

# Optional direct Docker observer overlay: compose.dev.observer.yaml.
# Host-equivalent privilege; read_only does NOT limit Docker API operations.
# Set these after verifying the physical host and `stat -c %g /var/run/docker.sock`.
# NH_DEV_PHYSICAL_HOST_ID=
# NH_DEV_DOCKER_GID=
# OBSERVER_ID/socket are passed only to API/worker by the overlay, not migrations.

# Optional Gateway overlay (separate operation-specific activation approval).
# Append compose.dev.gateway.yaml after real + observer overlays; use profile gateway.
# NH_DEV_GATEWAY_ID=GENERATE_DEDICATED_UUID
# NH_DEV_GATEWAY_CONTROL_TOKEN=GENERATE_INDEPENDENT_32_RANDOM_BYTES_BASE64URL
# NH_DEV_GATEWAY_HOST_PROC=/proc/VERIFIED_LONG_LIVED_HOST_PROCESS_PID
# Never substitute /proc/self. Revalidate after host reboot/process replacement.
