# Render @WORKSPACE@ to the verified absolute checkout. No installation by Compose.
[Unit]
Description=NickHosting development read-only host observer

[Service]
Type=simple
WorkingDirectory=@WORKSPACE@
EnvironmentFile=@WORKSPACE@/.env.dev-observer.local
ExecStart=/bin/sh @WORKSPACE@/scripts/dev.sh node --import tsx deploy/dev-host-observer.ts --recover-stale-socket
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=192M
TasksMax=32

[Install]
WantedBy=default.target
