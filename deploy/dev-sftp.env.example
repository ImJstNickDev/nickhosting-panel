# Copy to ignored .env.dev.sftp.local only during approved activation; mode 0600.
# Do not reuse viewer credentials. Never use production Pterodactyl keys here.
# SFTP state follows NH_MOUNTDATA_ROOT from the primary Compose interpolation file.
# The approved Wings data source below is independent of that NickHosting state root.
NH_SFTP_USERS_UID=REPLACE_WITH_VERIFIED_NONROOT_OWNER_UID
NH_SFTP_USERS_GID=REPLACE_WITH_VERIFIED_NONROOT_OWNER_GID
NH_SFTP_USERS_SERVER_DIRECTORY=/REPLACE/WITH/EXACT/EXISTING/SERVER/DIRECTORY
NH_SFTP_USERS_SERVER_UUID=REPLACE_WITH_PROVIDER_SERVER_UUID
NH_SFTP_USERS_BIND_IP=REPLACE_WITH_APPROVED_HOST_ADDRESS
NH_SFTP_USERS_PORT=2023
NH_SFTP_USERS_ADMIN=nickhosting-dev-sftp-admin
NH_SFTP_USERS_PASSWORD=REPLACE_WITH_NEW_RANDOM_SECRET
# Record the UUID for the Owner's sftpgoInstanceId; does not set application env.
NH_SFTP_USERS_INSTANCE_ID=REPLACE_WITH_NEW_INSTANCE_UUID
# Owner-facing hostname; set sftpPublicHostname in protected Owner settings.
NH_SFTP_USERS_HOSTNAME=sftp.dev.hub.nickhost.ing
