# Safe, illustrative configuration only. No real credentials/IPs.
NODE_ENV=development
# For a production deployment, use NH_PUBLIC_URL=https://hub.example.com
# This is a configurable deployment example, not a hardcoded application URL.
NH_PUBLIC_URL=http://localhost:3000
NH_API_URL=http://localhost:3001
# Internal listener is separate from the externally advertised API URL.
NH_API_BIND_HOST=localhost
NH_API_PORT=3001

# Database and job transport. For Docker deployment configure internal service names.
DATABASE_URL=postgresql://nickhosting:CHANGE_ME@localhost:5432/nickhosting
REDIS_URL=redis://localhost:6379
NH_JOB_PREFIX=nickhosting-development

# Generate cryptographically strong values outside Git.
BETTER_AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
NH_SECRETS_MASTER_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
NH_SECRETS_KEY_ID=primary
NH_SETUP_TOKEN=REPLACE_WITH_SECURE_ONE_TIME_BOOTSTRAP_TOKEN

# Optional explicit runtime overrides. Prefer first-run Owner setup otherwise.
# NH_PTERODACTYL_BASE_URL=https://pterodactyl.example.com
# Reserved deployment/planning examples below are not M2 runtime settings.
# Runtime DNS settings use NH_DNS_BASE_DOMAIN / NH_CLOUDFLARE_ZONE_ID below.
# NH_NODE_PUBLIC_BIND_IP=192.0.2.10
# NH_INTERNAL_DOCKER_DNS_IP=192.0.2.53
# NH_DNS_PROVIDER_ZONE=example.com
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_SECURE=false

# Email delivery must work before verified email/password Owner bootstrap.
# Optional settings default in code and remain editable in the Owner API.
# NH_INSTANCE_NAME=
# NH_DEFAULT_LOCALE=it
# NH_INVITE_TTL_SECONDS=86400
# NH_SUPPORT_IDLE_TTL_SECONDS=300
# NH_SUPPORT_ABSOLUTE_TTL_SECONDS=900
# NH_SESSION_TTL_SECONDS=604800
# NH_LOG_LEVEL=info
# NH_PTERODACTYL_APPLICATION_KEY=
# NH_PTERODACTYL_CLIENT_KEY=

# M2 resource defaults. Uncomment only to lock an explicit environment override.
# NH_STORAGE_POLICY=GLOBAL_POOL
# NH_DEFAULT_USER_MEMORY_MIB=16384
# NH_DEFAULT_USER_CPU_PERCENT=400
# NH_DEFAULT_USER_STORAGE_MIB=32768
# Optional total count cap: disabled by default; literal null overrides a DB cap.
# NH_MAX_SERVERS_PER_USER=null
# Pending provisioning jobs only; completed offline servers are not counted.
# NH_MAX_CONCURRENT_PROVISIONS_PER_USER=4
# Per-node exact private backend allocation pins and disjoint gateway bind addresses.
# Provider address and effective backendAddress are distinct for verified Wings
# loopback remapping; see docs/M2-API.md. Never infer the bridge interface.
# No default pool. Configure in Owner settings or override by managed-node UUID.
# NH_BACKEND_ALLOCATION_POOLS={}
# NH_OBSERVATION_MAX_AGE_SECONDS=15

# Exact backend destination origins; JSON arrays, no path/trailing slash.
# Leave unset until approved provider destinations are known.
# NH_PTERODACTYL_WEBSOCKET_ORIGINS=["wss://wings.example.com"]
# NH_PTERODACTYL_DOWNLOAD_ORIGINS=["https://backups.example.com"]
# NH_PTERODACTYL_UPLOAD_ORIGINS=[]

# Must match the Owner-configured physical host observer ID.
# Sampling this process's host is valid only when it is the actual game host.
# NH_OBSERVER_ID=REPLACE_WITH_CONFIGURED_OBSERVER_ID
# Required for lifecycle terminal proof: explicit local game-host Docker socket.
# This only configures read-only CLI observations; deployment access/mounts need approval.
# NH_DOCKER_OBSERVER_SOCKET=/REPLACE_WITH_APPROVED_LOCAL_DOCKER_SOCKET
# Optional JSON object keyed by physical-host UUID; {} overrides no hosts.
# Complete policy schema and deployment constraints: docs/M2-API.md.
# NH_HOST_POLICIES={}
# Uploads disabled until the Owner verifies provider bounds and disk-backed staging.
# Per-host policy or null, with full schema/recovery rules in docs/M2-API.md.
# Never put uploadPolicy inside NH_HOST_POLICIES; use this dedicated override.
# NH_UPLOAD_POLICIES={}
# Optional global override of managed-node physical memory overhead (100..400 percent).
# Owner node policy defaults to 115; verify the bound covers actual Wings tiers.
# NH_NODE_MEMORY_OVERHEAD_PERCENT=115

# SFTPGo is optional. Configure only an explicitly approved isolated data mapping.
# The root is an absolute provider-visible path; do not mount real Wings data
# without separate Owner approval. Instance IDs must be generated stable UUIDs.
# NH_SFTPGO_BASE_URL=https://sftp-admin.example.com
# NH_SFTPGO_DATA_ROOT=/REPLACE_WITH_APPROVED_SFTPGO_DATA_ROOT
# NH_SFTPGO_INSTANCE_ID=REPLACE_WITH_GENERATED_UUID
# NH_SFTPGO_API_KEY=REPLACE_WITH_SCOPED_SECRET
# NH_SFTP_CREDENTIAL_TTL_SECONDS=3600
# SFTPGo 2.7.6 cannot reliably revoke an existing SSH transport immediately.
# This narrow M2 exception must be revisited before production release.

# DNS writes require separate approval; M2 provider tests mock Cloudflare writes.
# NH_CLOUDFLARE_ZONE_ID=REPLACE_WITH_32_CHARACTER_ZONE_ID
# NH_CLOUDFLARE_API_TOKEN=REPLACE_WITH_ZONE_SCOPED_SECRET
# NH_DNS_INSTANCE_ID=REPLACE_WITH_GENERATED_UUID
# NH_DNS_BASE_DOMAIN=games.example.com
# NH_DNS_TARGET=origin.example.com
# NH_STATIC_GAME_HOSTNAME=play.example.com
# M3 Gateway: disabled until explicit routes, topology and deployment are approved.
# Complete schemas/prerequisites: docs/M3-API.md. No provider keys enter the Gateway.
# NH_GATEWAY_ENABLED=false
# NH_GATEWAY_ID=REPLACE_WITH_GENERATED_GATEWAY_UUID
# NH_GATEWAY_PHYSICAL_HOST_ID=REPLACE_WITH_MANAGED_HOST_UUID
# NH_GATEWAY_CORE_URL=https://core.example.com
# NH_GATEWAY_CONTROL_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_BASE64URL_SECRET
# NH_GATEWAY_LEASE_SECONDS=15
# JSON policies require complete validated objects, not inferred local addresses.
# NH_GATEWAY_NETWORK_POLICY=REPLACE_WITH_VERIFIED_NODE_POLICY_JSON
# NH_GATEWAY_OBSERVER=REPLACE_WITH_VERIFIED_HOST_OBSERVER_JSON
# NH_GATEWAY_NODE_PROBES={}
# NH_GATEWAY_DATA_POLICY=REPLACE_WITH_COMPLETE_TYPED_POLICY_JSON
# Bootstrap-only local trusted modules; none shipped for real games until M4/M5.
# NH_GATEWAY_PROTOCOL_MODULES=[]
# Optional Unix diagnostics socket inside project-owned mountdata; no TCP bind.
# NH_GATEWAY_DIAGNOSTICS_SOCKET=/REPLACE_WITH_WORKSPACE/mountdata/gateway/diagnostics.sock
